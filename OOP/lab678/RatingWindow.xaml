<Window x:Class="RouteBookingSystem.RatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource RateTitle}"
        Height="600"
        Width="400"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#FFF5F7FA"
        WindowStyle="SingleBorderWindow">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Styles/AdminStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>


	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Заголовок -->
		<TextBlock Grid.Row="0"
                   Text="{DynamicResource RateHeader}"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#FF2E7D32"
                   HorizontalAlignment="Center"
                   Margin="0 0 0 20"/>

		<!-- Поля для рейтинга и комментария -->
		<StackPanel Grid.Row="1" Margin="0 0 0 20">
			<TextBlock Text="{DynamicResource RatingLabel}" Margin="0 5"/>
			<ComboBox x:Name="RatingComboBox" SelectedIndex="0" Width="200">
				<ComboBoxItem>1</ComboBoxItem>
				<ComboBoxItem>2</ComboBoxItem>
				<ComboBoxItem>3</ComboBoxItem>
				<ComboBoxItem>4</ComboBoxItem>
				<ComboBoxItem>5</ComboBoxItem>
			</ComboBox>
			<TextBlock Text="{DynamicResource CommentLabel}" Margin="0 15 0 5"/>
			<TextBox x:Name="CommentTextBox" Height="100" TextWrapping="Wrap" AcceptsReturn="True"/>
		</StackPanel>

		<!-- Кнопки -->
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
			<Button Content="{DynamicResource SubmitRatingButton}"
                    Height="40"
                    Width="150"
                    Margin="10 0"
                    Click="SubmitRating_Click"/>
			<Button Content="{DynamicResource CancelButton}"
                    Height="40"
                    Width="150"
                    Margin="10 0"
					Background="#FF607D8B"
                    Foreground="White"
                    Click="Cancel_Click"/>
		</StackPanel>
	</Grid>
</Window>