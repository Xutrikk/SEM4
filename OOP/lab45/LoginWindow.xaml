<Window x:Class="RouteBookingSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}" 
        Height="485" 
        Width="691"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#FFF0F5F5">

    <Window.Resources>
        <!-- Общие стили из RegistrationWindow -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFB0BEC5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Margin" Value="0 0 0 15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FF4CAF50"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFB0BEC5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0 0 0 15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12 8"/>
            <Setter Property="Margin" Value="0 0 0 15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.15" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF45A049"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="PlaceholderStyle">
            <Setter Property="Foreground" Value="#FF78909C"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12 0 0 0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25 30">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center">
                <!-- Заголовок -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button Content="RU" Click="RussianButton_Click" Width="48"/>
                    <Button Content="EN" Click="EnglishButton_Click" Width="48"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource LoginTitle}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#FF2E7D32"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 35"/>

                <!-- Email -->
                <Grid>
                    <TextBox x:Name="txtEmail" 
                             TextChanged="txtEmail_TextChanged"/>
                    <TextBlock x:Name="txtEmailPlaceholder" 
                               Text="{DynamicResource Email}" 
                               Style="{StaticResource PlaceholderStyle}" Margin="12,12,0,0" VerticalAlignment="Top"/>
                </Grid>

                <!-- Пароль -->
                <Grid>
                    <PasswordBox x:Name="txtPassword" 
                                 PasswordChanged="txtPassword_PasswordChanged"
                                 PasswordChar="●"/>
                    <TextBlock x:Name="txtPasswordPlaceholder" 
                               Text="{DynamicResource Password}" 
                               Style="{StaticResource PlaceholderStyle}" Margin="12,12,0,0" VerticalAlignment="Top"/>
                </Grid>

                <!-- Кнопки -->
                <Button Content="{DynamicResource SignIn}" 
                        Height="45"
                        FontSize="16"
                        Margin="0 25 0 0"
                        Click="LoginButton_Click"/>

                <Button Content="{DynamicResource CreateAccount}"
                        Background="#FF607D8B"
                        Height="40"
                        Margin="0 15 0 0"
                        Click="RegisterButton_Click"/>
            </StackPanel>

        </ScrollViewer>
    </Grid>
</Window>