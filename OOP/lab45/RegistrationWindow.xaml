<Window x:Class="RouteBookingSystem.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource RegistrationTitle}" 
        Height="761" 
        Width="721"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#FFF0F5F5">

    <Window.Resources>
        <!-- Стиль для текстовых полей -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFB0BEC5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Margin" Value="0 0 0 15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FF4CAF50"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для PasswordBox -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFB0BEC5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0 0 0 15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для кнопок -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12 8"/>
            <Setter Property="Margin" Value="0 0 0 15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.15" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF45A049"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для плейсхолдеров -->
        <Style TargetType="TextBlock" x:Key="PlaceholderStyle">
            <Setter Property="Foreground" Value="#FF78909C"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12 0 0 0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25 30">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center">
                <!-- Заголовок -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button Content="RU" Click="RussianButton_Click" Width="48"/>
                    <Button Content="EN" Click="EnglishButton_Click" Width="48"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource RegistrationHeader}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#FF2E7D32"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 35"/>

                <!-- Имя -->
                <Grid>
                    <TextBox x:Name="txtFirstName" 
                             Text="{Binding FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock x:Name="firstNamePlaceholder" 
                               Text="{DynamicResource FirstName}" 
                               Style="{StaticResource PlaceholderStyle}" Margin="12,12,0,0" VerticalAlignment="Top"/>
                </Grid>

                <!-- Фамилия -->
                <Grid>
                    <TextBox x:Name="txtLastName" 
                             Text="{Binding LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock x:Name="lastNamePlaceholder" 
                               Text="{DynamicResource LastName}" 
                               Style="{StaticResource PlaceholderStyle}" Margin="12,12,0,0" VerticalAlignment="Top"/>
                </Grid>

                <!-- Отчество -->
                <Grid>
                    <TextBox x:Name="txtSurname" 
                             Text="{Binding Surname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock x:Name="surnamePlaceholder" 
                               Text="{DynamicResource Surname}" 
                               Style="{StaticResource PlaceholderStyle}" Margin="12,12,0,0" VerticalAlignment="Top"/>
                </Grid>

                <!-- Email -->
                <Grid>
                    <TextBox x:Name="txtEmail" 
                             Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock x:Name="emailPlaceholder" 
                               Text="{DynamicResource Email}" 
                               Style="{StaticResource PlaceholderStyle}" Margin="12,12,0,0" VerticalAlignment="Top"/>
                </Grid>

                <!-- Пароль -->
                <Grid>
                    <PasswordBox x:Name="txtPassword" 
                                 PasswordChanged="txtPassword_PasswordChanged"/>
                    <TextBlock x:Name="passwordPlaceholder" 
                               Text="{DynamicResource Password}" 
                               Style="{StaticResource PlaceholderStyle}" Margin="12,12,0,0" VerticalAlignment="Top"/>
                </Grid>

                <!-- Подтверждение пароля -->
                <Grid>
                    <PasswordBox x:Name="txtConfirmPassword" 
                                 PasswordChanged="txtConfirmPassword_PasswordChanged"/>
                    <TextBlock x:Name="confirmPasswordPlaceholder" 
                               Text="{DynamicResource Confirm}" 
                               Style="{StaticResource PlaceholderStyle}" Margin="12,12,0,0" VerticalAlignment="Top"/>
                </Grid>

                <!-- Телефон -->
                <Grid>
                    <TextBox x:Name="txtPhone" 
                             Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock x:Name="phonePlaceholder" 
                               Text="{DynamicResource Phone}" 
                               Style="{StaticResource PlaceholderStyle}" Margin="12,12,0,0" VerticalAlignment="Top"/>
                </Grid>

                <!-- Кнопки -->
                <Button Content="{DynamicResource CreateAccountButton}"
                        Height="45"
                        FontSize="16"
                        Margin="0 25 0 0"
                        Click="RegisterButton_Click"/>

                <Button Content="{DynamicResource BackToLoginButton}"
                        Background="#FF607D8B"
                        Height="40"
                        Margin="0 15 0 0"
                        Click="LoginButton_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>