<Window x:Class="lab4wpf5oop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Бронирование маршрутов" Height="600" Width="800">
    <Grid>
        <TabControl>
            <!-- Вкладка с маршрутами -->
            <TabItem Header="Маршруты">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Фильтры -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox x:Name="cmbFrom" 
                                  Width="150" 
                                  Margin="5" 
                                  ItemsSource="{Binding Cities}"
                                  DisplayMemberPath="From"
                                  SelectedValuePath="From"/>

                        <ComboBox x:Name="cmbTo" 
                                  Width="150" 
                                  Margin="5" 
                                  ItemsSource="{Binding Cities}"
                                  DisplayMemberPath="To"
                                  SelectedValuePath="To"/>

                        <ComboBox x:Name="cmbType" 
                                  Width="120" 
                                  Margin="5"
                                  ItemsSource="{Binding TransportTypes}"/>

                        <Button Content="Поиск" 
                                Width="80" 
                                Margin="5" 
                                Click="SearchButton_Click"/>
                    </StackPanel>

                    <!-- Список маршрутов -->
                    <DataGrid Grid.Row="1" 
                              x:Name="dgTickets" 
                              AutoGenerateColumns="False" 
                              ItemsSource="{Binding Tickets}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Откуда" Binding="{Binding From}"/>
                            <DataGridTextColumn Header="Куда" Binding="{Binding To}"/>
                            <DataGridTextColumn Header="Время" Binding="{Binding Time}"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price}"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding Type}"/>
                            <DataGridTemplateColumn Header="Действие">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Купить" Click="BuyTicket_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка с купленными билетами -->
            <TabItem Header="Мои билеты">
                <DataGrid x:Name="dgPurchasedTickets" 
                          AutoGenerateColumns="False" 
                          ItemsSource="{Binding PurchasedTickets}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Откуда" Binding="{Binding From}"/>
                        <DataGridTextColumn Header="Куда" Binding="{Binding To}"/>
                        <DataGridTextColumn Header="Время покупки" Binding="{Binding PurchaseTime}"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>